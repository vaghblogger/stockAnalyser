# Stock Analysis Agent - copy to .env and set as needed
# API (for n8n HTTP nodes)
API_BASE=http://localhost:8000
# Data
DATA_PROVIDER=yfinance
CACHE_DIR=data/cache
# Sentiment
SENTIMENT_PROVIDER=free_news_finbert
# LLM (for n8n OpenAI node or future Python signal agent)
OPENAI_API_KEY=
