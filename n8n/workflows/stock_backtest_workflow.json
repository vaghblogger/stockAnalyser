{
  "name": "Stock Backtest - Trigger and Report",
  "nodes": [
    {
      "parameters": {},
      "id": "trigger-manual",
      "name": "Manual Trigger",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [0, 0]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://127.0.0.1:8000/backtest",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"symbol\": \"{{ $json.symbol || 'RELIANCE' }}\",\n  \"start\": \"{{ $json.start || '2023-01-01' }}\",\n  \"end\": \"{{ $json.end || '2024-06-01' }}\",\n  \"lookback_days\": {{ $json.lookback_days || 90 }},\n  \"hold_days\": {{ $json.hold_days || 5 }},\n  \"step_days\": {{ $json.step_days || 5 }},\n  \"strategy_id\": \"{{ $json.strategy_id || '' }}\"\n}",
        "options": {}
      },
      "id": "http-backtest",
      "name": "POST Backtest",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [220, 0]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            { "id": "metrics", "name": "metrics", "value": "={{ $json.metrics }}", "type": "object" },
            { "id": "rows_count", "name": "rows_count", "value": "={{ $json.rows ? $json.rows.length : 0 }}", "type": "number" },
            { "id": "strategy", "name": "strategy", "value": "={{ $json.strategy }}", "type": "object" },
            { "id": "by_symbol", "name": "by_symbol", "value": "={{ $json.by_symbol }}", "type": "object" }
          ]
        },
        "options": {}
      },
      "id": "set-report",
      "name": "Report",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.2,
      "position": [440, 0]
    }
  ],
  "connections": {
    "Manual Trigger": { "main": [[{ "node": "POST Backtest", "type": "main", "index": 0 }]] },
    "POST Backtest": { "main": [[{ "node": "Report", "type": "main", "index": 0 }]] }
  },
  "pinData": {},
  "settings": { "executionOrder": "v1" },
  "staticData": null,
  "meta": { "templateCredsSetupCompleted": true }
}
