# ========== STEPS TO START APP AND BACKEND ==========
# 1. From project root, activate venv (optional; you can call .venv/bin/python directly):
#    source .venv/bin/activate   # macOS/Linux
#
# 2. Start the backend (API + web app). Keep this terminal open.
#    IMPORTANT: use a space between "uvicorn" and "src" (not uvicornsrc)
#    cd /Users/vagh/Cursor/StockAnalysis && .venv/bin/uvicorn src.api.main:app --host 0.0.0.0 --port 8000
#
# 3. Open the web app in a browser:
#    http://127.0.0.1:8000/app
#
# 4. (Optional) Start n8n for workflow orchestration — in a second terminal:
#    N8N_SECURE_COOKIE=false npx n8n
#    Then open http://127.0.0.1:5678 and import workflows from n8n/workflows/
# ====================================================

# Start API (keep running) — note space: "uvicorn" then "src.api.main:app"
.venv/bin/uvicorn src.api.main:app --host 0.0.0.0 --port 8000

# Start n8n (free plan: no Variables)
N8N_SECURE_COOKIE=false npx n8n

# Cache DB init (if table missing)
.venv/bin/python -c "from src.data.cache import init_cache_db; from src.config_loader import get_config; init_cache_db(get_config().cache_dir); print('Done')"

# Query cache
sqlite3 data/cache/ohlcv.db "SELECT symbol, date, close FROM ohlcv ORDER BY date DESC LIMIT 10"

# n8n "connection refused" fix: workflows use http://127.0.0.1:8000 (not localhost). Re-import workflow JSON. If n8n runs in Docker, use http://host.docker.internal:8000 in each HTTP node.

# --- Where to analyse data ---
# Web app (visualise workflow data): http://127.0.0.1:8000/app — candlestick, RSI, MACD, sentiment, signal; backtest equity + metrics.
